# The repository root is the build context of market-fetcher only
# (see market-fetcher/Dockerfile), so everything else stays out of it.
*
!market-fetcher
!proxy-common

# Git
**/.git
**/.gitignore

# Binaries and build files
market-fetcher/bin
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib

# Test binary, built with `go test -c`
**/*.test

# Output of the go coverage tool
**/*.out

# Go workspace file
**/go.work

# IDE specific files
**/.idea
**/.vscode
**/*.swp
**/*.swo

# OS specific files
**/.DS_Store
**/Thumbs.db

# Configuration files that shouldn't be in Docker
market-fetcher/config.local.yaml
**/*.env
**/*.env.*
!**/.env.example

# Debug files
market-fetcher/debug
